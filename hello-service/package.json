{
  "name": "hello-service",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node --env-file=.env node_modules/@nestjs/cli/bin/nest.js start",
    "start:dev": "node --env-file=.env node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:prod": "node --env-file=.env dist/main",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.3",
    "@grpc/proto-loader": "0.8.0",
    "@nestjs/common": "11.1.17",
    "@nestjs/core": "11.1.17",
    "@nestjs/microservices": "11.1.17",
    "@nestjs/platform-express": "11.1.17",
    "@nestjs/swagger": "11.2.6",
    "@scalar/nestjs-api-reference": "1.1.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5", "@eslint/js": "9.39.4",
    "@nestjs/cli": "11.0.17", "@nestjs/schematics": "11.0.10", "@nestjs/testing": "11.1.17",
    "@types/express": "5.0.6", "@types/jest": "30.0.0", "@types/node": "22.19.15",
    "eslint": "9.39.4", "eslint-config-prettier": "10.1.8", "eslint-plugin-prettier": "5.5.5",
    "globals": "16.5.0", "jest": "30.3.0", "prettier": "3.8.1",
    "ts-jest": "29.4.6", "ts-loader": "9.5.4", "ts-node": "10.9.2",
    "typescript": "5.9.3", "typescript-eslint": "8.58.0"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"], "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$", "transform": {"^.+\\.(t|j)s$": "ts-jest"},
    "testEnvironment": "node"
  }
}
